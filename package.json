{
  "name": "olivestudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm --filter @olivestudio/editor dev",
    "build": "pnpm --filter @olivestudio/editor build && pnpm --filter @olivestudio/editor build:native",
    "build:engine": "pnpm --filter @olivestudio/engine build",
    "pack:engine": "pnpm build:engine && node scripts/pack-engine.mjs",
    "test:engine": "pnpm pack:engine && node scripts/standalone-engine-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "release:mac:check": "node scripts/release-mac.mjs --check",
    "release:mac": "node scripts/release-mac.mjs",
    "lint": "eslint . && node scripts/boundaries.mjs",
    "test": "vitest run && node --test scripts/mac-app.test.mjs",
    "package:mac": "node scripts/mac-app.mjs --mode local",
    "postinstall": "pnpm --filter @olivestudio/editor exec install-electron",
    "build:cleanup": "node scripts/mac-app.mjs --cleanup",
    "test:packaging": "node --test scripts/mac-app.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:desktop": "pnpm --filter @olivestudio/editor test:desktop",
    "test:e2e": "pnpm --filter @olivestudio/editor test:e2e"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/howler": "2.2.13",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "eslint": "10.12.0",
    "typescript-eslint": "8.72.2",
    "globals": "16.5.0",
    "vite": "7.3.1"
  }
}
