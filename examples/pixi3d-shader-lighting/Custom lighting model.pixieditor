  "pixi3d-editor": "1.0.0"
 },
 "providers": {
  "audio": "howler",
  "tween": "gsap",
  "physics": "matter",
  "render": "pixi"
 },
 "extensions": {
  "assets.registry": {
   "version": 1,
   "items": []
  },
  "pixi3d.shaders": {
   "version": 1,
   "items": [
    {
     "params": [
      {
       "name": "warm",
       "type": "color",
       "default": "#ffb35c"
      },
      {
       "name": "cool",
       "type": "color",
       "default": "#2c4a8c"
      },
      {
       "name": "rim",
       "type": "float",
       "default": 0.6
      }
     ],
     "name": "Warm and cool",
     "kind": "lighting",
     "wgsl": {
      "header": "",
      "material": "",
      "preLighting": "  var shade = vec3<f32>(0.0);",
      "perLight": "    // From cool (facing away) to warm (facing the light), in the light's colour.\n    let lit = nDotL * attenuation * shadow;\n    shade += mix(material.cool.rgb, material.warm.rgb, lit) * light.color * 0.6;",
      "postLighting": "  let rimLight = pow(1.0 - max(dot(normal, viewDir), 0.0), 3.0) * material.rim;\n  finalColor = albedo * (shade + material.cool.rgb * 0.25) + vec3<f32>(rimLight);"
     },
     "glsl": {
      "header": "",
      "material": "",
      "preLighting": "  vec3 shade = vec3(0.0);",
      "perLight": "    // From cool (facing away) to warm (facing the light), in the light's colour.\n    float lit = nDotL * attenuation * shadow;\n    shade += mix(material.cool.rgb, material.warm.rgb, lit) * light.color * 0.6;",
      "postLighting": "  float rimLight = pow(1.0 - max(dot(normal, viewDir), 0.0), 3.0) * material.rim;\n  finalColor = albedo * (shade + material.cool.rgb * 0.25) + vec3(rimLight);"
     },
     "id": "a953e771-22eb-42c0-8cbf-d2615adec3b0"
    }
   ]
  }
 }
}
