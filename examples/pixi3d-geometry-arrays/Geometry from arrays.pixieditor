  "scripts.library": {
   "version": 1,
   "items": [
    {
     "id": "ad5cc09c-ea3c-4882-8380-7f68d733a565",
     "name": "Hills",
     "source": "// A height field from arrays: one vertex per grid point, two triangles per cell, uvs for the colour map.\nexport const params = {size: param.number(48, {min: 4, max: 200, label: 'Cells per side'})};\nexport function start(self: GameObject3D) {\n  const n = self.params.size, positions: number[] = [], uvs: number[] = [], indices: number[] = [];\n  for (let z = 0; z <= n; z++) for (let x = 0; x <= n; x++) {\n    const u = x / n, v = z / n, px = (u - 0.5) * 8, pz = (v - 0.5) * 8;\n    positions.push(px, Math.sin(px * 1.3) * Math.cos(pz * 1.1) * 0.45 + Math.sin(px * 0.4 + pz * 0.7) * 0.3, pz);\n    uvs.push(u * 4, v * 4);\n  }\n  for (let z = 0; z < n; z++) for (let x = 0; x < n; x++) { const a = z * (n + 1) + x, b = a + n + 1; indices.push(a, b, a + 1, a + 1, b, b + 1); }\n  // No normals given: the host works them out from the triangles.\n  self.mesh.geometry = game.geometry({positions, uvs, indices});\n}\n",
     "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true});// A height field from arrays: one vertex per grid point, two triangles per cell, uvs for the colour map.\n const params = {size: param.number(48, {min: 4, max: 200, label: 'Cells per side'})}; exports.params = params;\n function start(self) {\n  const n = self.params.size, positions = [], uvs = [], indices = [];\n  for (let z = 0; z <= n; z++) for (let x = 0; x <= n; x++) {\n    const u = x / n, v = z / n, px = (u - 0.5) * 8, pz = (v - 0.5) * 8;\n    positions.push(px, Math.sin(px * 1.3) * Math.cos(pz * 1.1) * 0.45 + Math.sin(px * 0.4 + pz * 0.7) * 0.3, pz);\n    uvs.push(u * 4, v * 4);\n  }\n  for (let z = 0; z < n; z++) for (let x = 0; x < n; x++) { const a = z * (n + 1) + x, b = a + n + 1; indices.push(a, b, a + 1, a + 1, b, b + 1); }\n  // No normals given: the host works them out from the triangles.\n  self.mesh.geometry = game.geometry({positions, uvs, indices});\n} exports.start = start;\n"
    },
    {
     "id": "e0c9db02-c94c-493f-8175-0661ade5646f",
     "name": "Gem",
     "source": "// Eight triangles listed vertex by vertex (no indices): every face keeps its own normal, so it shades flat.\nexport function start(self: GameObject3D) {\n  const top = [0, 0.7, 0], bottom = [0, -0.7, 0], ring = [[0.5, 0, 0], [0, 0, -0.5], [-0.5, 0, 0], [0, 0, 0.5]], positions: number[] = [];\n  for (let i = 0; i < 4; i++) { const a = ring[i], b = ring[(i + 1) % 4]; positions.push(...top, ...b, ...a, ...bottom, ...a, ...b); }\n  self.mesh.geometry = game.geometry({positions});\n}\nexport function update(self: GameObject3D, dt: number) { self.rotation.y += 45 * dt; }\n",
     "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true});// Eight triangles listed vertex by vertex (no indices): every face keeps its own normal, so it shades flat.\n function start(self) {\n  const top = [0, 0.7, 0], bottom = [0, -0.7, 0], ring = [[0.5, 0, 0], [0, 0, -0.5], [-0.5, 0, 0], [0, 0, 0.5]], positions = [];\n  for (let i = 0; i < 4; i++) { const a = ring[i], b = ring[(i + 1) % 4]; positions.push(...top, ...b, ...a, ...bottom, ...a, ...b); }\n  self.mesh.geometry = game.geometry({positions});\n} exports.start = start;\n function update(self, dt) { self.rotation.y += 45 * dt; } exports.update = update;\n"
    }
   ]
  }
 }
