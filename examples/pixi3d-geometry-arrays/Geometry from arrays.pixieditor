    {
     "id": "96215984-b431-453d-85a4-8bf87fffbb2e",
     "name": "Checker",
     "type": "pixi.texture",
     "revision": "225a7826fe362550c8b4838b19e169476a1fa3c9a51dce8e0b46d837072544e7",
     "source": {
