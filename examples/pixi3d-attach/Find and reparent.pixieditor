  "assets.registry": {
   "version": 1,
   "items": []
  },
  "scripts.library": {
   "version": 1,
   "items": [
    {
     "id": "feb2f4ab-153f-4d19-8850-6587bae5aa85",
     "name": "Load",
     "source": "// Click: this crate becomes a child of the cart, keeping where it is in the world, so it rides along.\nexport function onClick(self: GameObject3D) {\n  self.parent = game.find<GameObject3D>('Cart');\n}\n",
     "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true});// Click: this crate becomes a child of the cart, keeping where it is in the world, so it rides along.\n function onClick(self) {\n  self.parent = game.find('Cart');\n} exports.onClick = onClick;\n"
    },
    {
     "id": "2c92b1e1-ea45-4170-8f5c-fb48d9e5e987",
     "name": "Unload",
     "source": "// Click: every crate riding on the cart goes back to the top of the 3D view, staying where it is.\nexport function onClick(self: GameObject3D) {\n  for (const crate of game.find<GameObject3D>('Cart')!.children) if (crate.name.startsWith('Crate')) crate.parent = null;\n}\n",
     "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true});// Click: every crate riding on the cart goes back to the top of the 3D view, staying where it is.\n function onClick(self) {\n  for (const crate of game.find('Cart').children) if (crate.name.startsWith('Crate')) crate.parent = null;\n} exports.onClick = onClick;\n"
    }
   ]
  }
 }
}
