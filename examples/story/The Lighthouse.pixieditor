  "providers": {
    "audio": "howler",
    "tween": "gsap",
    "physics": "matter",
    "render": "pixi"
  },
  "extensions": {
    "pixi.render": {
      "version": 1,
      "background": "#0b1d33"
    },
    "interactions.strings": {
      "version": 1,
      "defaultLanguage": "en",
      "languages": [
        {
          "id": "en",
          "name": "English"
        },
        {
          "id": "tr",
          "name": "Türkçe"
        }
      ],
      "entries": [
        {
          "key": "story.intro",
          "values": {
            "en": "A storm rolls in. The old lighthouse has been dark for years, and a boat is still out at sea.",
            "tr": "Bir fırtına yaklaşıyor. Eski deniz feneri yıllardır karanlık ve denizde hâlâ bir tekne var."
          }
        },
        {
          "key": "story.stairs",
          "values": {
            "en": "You climb 117 rusty steps. At the top, the great lamp waits under a sheet of dust.",
            "tr": "Paslı 117 basamağı tırmanıyorsun. Tepede büyük lamba bir toz örtüsünün altında bekliyor."
          }
        },
        {
          "key": "story.shore",
          "values": {
            "en": "On the shore you find a rowing boat and an oil lantern that still has a little fuel.",
            "tr": "Kıyıda bir kayık ve içinde hâlâ biraz yağ olan bir fener buluyorsun."
          }
        },
        {
          "key": "story.lit",
          "values": {
            "en": "The lamp roars to life. Its beam sweeps the waves and the boat turns safely toward the harbour.",
            "tr": "Lamba canlanıyor. Işığı dalgaları tarıyor ve tekne güvenle limana yöneliyor."
          }
        },
        {
          "key": "story.rowed",
          "values": {
            "en": "You row into the dark, lantern held high. The sailors see you and follow you home.",
            "tr": "Feneri yukarıda tutarak karanlığa kürek çekiyorsun. Denizciler seni görüp eve kadar izliyor."
          }
        },
        {
          "key": "story.choose",
          "values": {
            "en": "What do you do?",
            "tr": "Ne yapıyorsun?"
          }
        },
        {
          "key": "story.climb",
          "values": {
            "en": "Climb the tower",
            "tr": "Kuleye tırman"
          }
        },
        {
          "key": "story.walk",
          "values": {
            "en": "Walk the shore",
            "tr": "Kıyıda yürü"
          }
        },
        {
          "key": "story.light",
          "values": {
            "en": "Light the lamp",
            "tr": "Lambayı yak"
          }
        },
        {
          "key": "story.row",
          "values": {
            "en": "Row out to sea",
            "tr": "Denize açıl"
          }
        },
        {
          "key": "story.back",
          "values": {
            "en": "Go back",
            "tr": "Geri dön"
          }
        },
        {
          "key": "story.again",
          "values": {
            "en": "Begin again",
            "tr": "Baştan başla"
          }
        },
        {
          "key": "story.title",
          "values": {
            "en": "The Lighthouse",
            "tr": "Deniz Feneri"
          }
        },
        {
          "key": "story.end",
          "values": {
            "en": "The end",
            "tr": "Son"
          }
        }
      ]
    }
  }
}
