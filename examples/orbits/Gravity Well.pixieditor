        "Default"
      ]
    },
    "scripts.library": {
      "version": 1,
      "items": [
        {
          "id": "s-orbit",
          "name": "Gravity",
          "source": "export const params = { pull: param.number(5200000, { label: 'Sun pull (GM)' }) };\nexport function update(self: SceneSelf, dt: number) {\n  const sun = game.find('Sun'), planets = game.findAll('Planet');\n  for (const p of planets) {\n    let ax = 0, ay = 0;\n    const add = (o: GameObject, gm: number) => { const dx = o.x - p.x, dy = o.y - p.y, d2 = Math.max(400, dx * dx + dy * dy), d = Math.sqrt(d2); ax += gm * dx / (d2 * d); ay += gm * dy / (d2 * d); };\n    add(sun, self.params.pull);\n    for (const q of planets) if (q !== p) add(q, self.params.pull * 0.004 * q.body.mass / p.body.mass);\n    p.body.push(ax * dt, ay * dt);\n  }\n}",
          "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true}); const params = { pull: param.number(5200000, { label: 'Sun pull (GM)' }) }; exports.params = params;\n function update(self, dt) {\n  const sun = game.find('Sun'), planets = game.findAll('Planet');\n  for (const p of planets) {\n    let ax = 0, ay = 0;\n    const add = (o, gm) => { const dx = o.x - p.x, dy = o.y - p.y, d2 = Math.max(400, dx * dx + dy * dy), d = Math.sqrt(d2); ax += gm * dx / (d2 * d); ay += gm * dy / (d2 * d); };\n    add(sun, self.params.pull);\n    for (const q of planets) if (q !== p) add(q, self.params.pull * 0.004 * q.body.mass / p.body.mass);\n    p.body.push(ax * dt, ay * dt);\n  }\n} exports.update = update;"
        },
        {
          "id": "s-planet",
          "name": "Planet",
          "source": "export function onCollision(self: GameObject, other: GameObject) {\n  if (other.name !== 'Sun') return;\n  const r = 180 + Math.random() * 200, a = Math.random() * Math.PI * 2, v = Math.sqrt(5200000 / r);\n  self.body.teleport(480 + Math.cos(a) * r, 270 + Math.sin(a) * r);\n  self.body.velocity = { x: -Math.sin(a) * v, y: Math.cos(a) * v };\n  game.camera.shake(8, 0.25);\n}",
          "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true}); function onCollision(self, other) {\n  if (other.name !== 'Sun') return;\n  const r = 180 + Math.random() * 200, a = Math.random() * Math.PI * 2, v = Math.sqrt(5200000 / r);\n  self.body.teleport(480 + Math.cos(a) * r, 270 + Math.sin(a) * r);\n  self.body.velocity = { x: -Math.sin(a) * v, y: Math.cos(a) * v };\n  game.camera.shake(8, 0.25);\n} exports.onCollision = onCollision;"
        }
      ],
      "scenes": {
        "s-space": {
          "scriptId": "s-orbit",
          "params": {},
          "refs": {}
        }
      }
    }
  }
