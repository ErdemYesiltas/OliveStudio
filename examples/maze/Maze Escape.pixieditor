      "version": 1,
      "background": "#020617"
    },
    "physics.world": {
      "gravityX": 0,
      "gravityY": 0,
      "timeScale": 1,
      "sleeping": false,
      "positionIterations": 8,
      "velocityIterations": 6,
      "walls": false,
      "layers": [
        "Default"
      ]
    },
    "interactions.globals": {
      "version": 1,
      "items": [
        {
          "id": "g-mx",
          "name": "moveX",
          "type": "number",
          "initial": 0
        },
        {
          "id": "g-my",
          "name": "moveY",
          "type": "number",
          "initial": 0
        },
        {
          "id": "g-keys",
          "name": "keys",
          "type": "number",
          "initial": 0
        }
      ]
    },
    "input.map": {
      "version": 1,
      "deadzone": 0.2,
      "actions": [
        {
          "id": "a-mx",
          "name": "MoveX",
          "kind": "axis",
          "bindings": [
            {
              "type": "keyAxis",
              "negative": "ArrowLeft",
              "positive": "ArrowRight"
            },
            {
              "type": "keyAxis",
              "negative": "KeyA",
              "positive": "KeyD"
            }
          ],
          "globalId": "g-mx"
        },
        {
          "id": "a-my",
          "name": "MoveY",
          "kind": "axis",
          "bindings": [
            {
              "type": "keyAxis",
              "negative": "ArrowUp",
              "positive": "ArrowDown"
            },
            {
              "type": "keyAxis",
              "negative": "KeyW",
              "positive": "KeyS"
            }
          ],
          "globalId": "g-my"
        }
      ]
    },
    "scripts.library": {
      "version": 1,
      "items": [
        {
          "id": "s-explorer",
          "name": "Explorer",
          "source": "export const params = { speed: param.number(230) };\nexport function start(self: GameObject) { self.state.spawn = { x: self.x, y: self.y }; globals.keys = 0; }\nexport function update(self: GameObject) {\n  const x = globals.moveX, y = globals.moveY, length = Math.hypot(x, y) || 1, k = Math.min(1, Math.hypot(x, y)) / length;\n  self.body.velocity = { x: x * k * self.params.speed, y: y * k * self.params.speed };\n}\nexport function onCollision(self: GameObject, other: GameObject) {\n  if (other.name.endsWith(' key') && other.active) {\n    other.active = false; globals.keys += 1;\n    const door = game.find(other.name.replace('key', 'door')); if (door) door.active = false;\n  }\n  if (other.name === 'Guard') { self.body.teleport(self.state.spawn.x, self.state.spawn.y); game.camera.shake(12, 0.3); }\n  if (other.name === 'Exit') game.changeScene('Escaped');\n}",
          "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true}); const params = { speed: param.number(230) }; exports.params = params;\n function start(self) { self.state.spawn = { x: self.x, y: self.y }; globals.keys = 0; } exports.start = start;\n function update(self) {\n  const x = globals.moveX, y = globals.moveY, length = Math.hypot(x, y) || 1, k = Math.min(1, Math.hypot(x, y)) / length;\n  self.body.velocity = { x: x * k * self.params.speed, y: y * k * self.params.speed };\n} exports.update = update;\n function onCollision(self, other) {\n  if (other.name.endsWith(' key') && other.active) {\n    other.active = false; globals.keys += 1;\n    const door = game.find(other.name.replace('key', 'door')); if (door) door.active = false;\n  }\n  if (other.name === 'Guard') { self.body.teleport(self.state.spawn.x, self.state.spawn.y); game.camera.shake(12, 0.3); }\n  if (other.name === 'Exit') game.changeScene('Escaped');\n} exports.onCollision = onCollision;"
        }
      ]
    }
  }
