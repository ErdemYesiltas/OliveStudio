 "extensions": {
  "assets.registry": {
   "version": 1,
   "items": [
    {
     "id": "a57b0a20-4f1e-4ad1-86dc-ffc95260dedf",
     "name": "Hologram grid",
     "type": "pixi.texture",
     "revision": "8e897efc491f6fd798d6127f1b96d35bff5826f25d69bf37795410c88f1d954d",
     "source": {
      "extension": "png",
      "bytes": 460
     },
     "metadata": {
      "width": 128,
      "height": 128,
      "processedBytes": 460,
      "pipeline": "pixi3d-examples"
     }
    }
   ]
  },
  "pixi3d.shaders": {
   "version": 1,
   "items": [
    {
     "params": [
      {
       "name": "pattern",
       "type": "texture"
      },
      {
       "name": "tint",
       "type": "color",
       "default": "#59d8ff"
      },
      {
       "name": "lines",
       "type": "float",
       "default": 14
      },
      {
       "name": "speed",
       "type": "float",
       "default": 1.2
      }
     ],
     "name": "Hologram",
     "kind": "material",
     "wgsl": {
      "header": "",
      "material": "  // The pattern, tinted, with bright scan lines running up the object.\n  let tex = samplePattern(input.vUV * 2.0);\n  let scan = 0.55 + 0.45 * sin((input.vPosition.y * material.lines - material.time * material.speed) * 6.2831);\n  albedo = tex.rgb * material.tint.rgb * scan * 1.6;\n  alpha = 1.0;",
      "preLighting": "",
      "perLight": "",
      "postLighting": ""
     },
     "glsl": {
      "header": "",
      "material": "  // The pattern, tinted, with bright scan lines running up the object.\n  vec4 tex = samplePattern(vUV * 2.0);\n  float scan = 0.55 + 0.45 * sin((vPosition.y * material.lines - material.time * material.speed) * 6.2831);\n  albedo = tex.rgb * material.tint.rgb * scan * 1.6;\n  alpha = 1.0;",
      "preLighting": "",
      "perLight": "",
      "postLighting": ""
     },
     "id": "b3c0938a-06c5-4a9c-823c-ca201401e022"
    }
   ]
  }
 }
}
