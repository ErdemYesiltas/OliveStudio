  "pixi3d.shaders": {
   "version": 1,
   "items": [
    {
     "params": [
      {
       "name": "clouds",
       "type": "texture"
      },
      {
       "name": "scale",
       "type": "float",
       "default": 0.12
      },
      {
       "name": "speed",
       "type": "float",
       "default": 0.05
      },
      {
       "name": "darkness",
       "type": "float",
       "default": 0.65
      }
     ],
     "name": "Cloud shadows",
     "kind": "extra",
     "wgsl": {
      "header": "",
      "material": "  // World x and z pick the spot in the cloud texture (it repeats), so every object agrees.\n  let uv = input.vPosition.xz * material.scale + vec2<f32>(material.time * material.speed, 0.0);\n  let cover = sampleClouds(uv).r;\n  albedo *= 1.0 - cover * material.darkness;",
      "preLighting": "",
      "perLight": "",
      "postLighting": ""
     },
     "glsl": {
      "header": "",
      "material": "  // World x and z pick the spot in the cloud texture (it repeats), so every object agrees.\n  vec2 uv = vPosition.xz * material.scale + vec2(material.time * material.speed, 0.0);\n  float cover = sampleClouds(uv).r;\n  albedo *= 1.0 - cover * material.darkness;",
      "preLighting": "",
      "perLight": "",
      "postLighting": ""
     },
     "id": "93250f04-8cdd-4be2-87c6-621b01c34e71"
    }
   ]
