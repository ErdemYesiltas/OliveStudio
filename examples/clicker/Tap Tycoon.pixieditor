      ]
    },
    "scripts.library": {
      "version": 1,
      "items": [
        {
          "id": "s-coin",
          "name": "CoinTap",
          "source": "export function onClick(self: GameObject) {\n  globals.coins += globals.perTap;\n  self.play('tween');\n}",
          "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true}); function onClick(self) {\n  globals.coins += globals.perTap;\n  self.play('tween');\n} exports.onClick = onClick;"
        },
        {
          "id": "s-shop",
          "name": "ShopButton",
          "source": "export const params = { kind: param.choice(['tap', 'helper'] as const) };\nconst cost = (kind: string) => kind === 'tap' ? globals.tapCost : globals.helperCost;\nexport function update(self: GameObject) { self.alpha = globals.coins >= cost(self.params.kind) ? 1 : 0.5; }\nexport function onClick(self: GameObject) {\n  const kind = self.params.kind, price = cost(kind);\n  if (globals.coins < price) { game.camera.shake(6, 0.2); return; }\n  globals.coins -= price;\n  if (kind === 'tap') { globals.perTap += 1; globals.tapCost = Math.round(price * 1.6); }\n  else { globals.perSecond += 1; globals.helperCost = Math.round(price * 1.5); }\n}",
          "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true}); const params = { kind: param.choice(['tap', 'helper'] ) }; exports.params = params;\nconst cost = (kind) => kind === 'tap' ? globals.tapCost : globals.helperCost;\n function update(self) { self.alpha = globals.coins >= cost(self.params.kind) ? 1 : 0.5; } exports.update = update;\n function onClick(self) {\n  const kind = self.params.kind, price = cost(kind);\n  if (globals.coins < price) { game.camera.shake(6, 0.2); return; }\n  globals.coins -= price;\n  if (kind === 'tap') { globals.perTap += 1; globals.tapCost = Math.round(price * 1.6); }\n  else { globals.perSecond += 1; globals.helperCost = Math.round(price * 1.5); }\n} exports.onClick = onClick;"
        },
        {
          "id": "s-income",
          "name": "Income",
          "source": "export function update(self: SceneSelf, dt: number) {\n  self.state.t = (self.state.t ?? 0) + dt;\n  while (self.state.t >= 1) { self.state.t -= 1; globals.coins += globals.perSecond; }\n}",
          "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true}); function update(self, dt) {\n  self.state.t = (self.state.t ?? 0) + dt;\n  while (self.state.t >= 1) { self.state.t -= 1; globals.coins += globals.perSecond; }\n} exports.update = update;"
        }
      ],
      "scenes": {
        "s-shop": {
          "scriptId": "s-income",
          "params": {},
          "refs": {}
        }
      }
    }
  }
