    "physics": "1.0.0",
    "matter": "1.0.0",
    "spine": "1.0.0",
    "spine-audio": "1.0.0",
    "interactions": "1.0.0",
    "interaction-media": "1.0.0",
    "scripts": "1.0.0",
    "input": "1.0.0",
    "build": "1.0.0",
    "html-export": "1.0.0",
    "prefabs": "1.0.0",
    "project-ui": "1.0.0",
    "recovery": "1.0.0",
    "studio": "1.0.0"
  },
  "providers": {
    "audio": "howler",
    "tween": "gsap",
    "physics": "matter",
    "render": "pixi"
  },
  "extensions": {
    "pixi.render": {
      "version": 1,
      "background": "#14162b"
    },
    "physics.world": {
      "gravityX": 0,
      "gravityY": 0,
      "timeScale": 1,
      "sleeping": false,
      "positionIterations": 8,
      "velocityIterations": 6,
      "walls": false,
      "layers": [
        "Default"
      ]
    },
    "interactions.globals": {
      "version": 1,
      "items": [
        {
          "id": "g-move",
          "name": "move",
          "type": "number",
          "initial": 0
        },
        {
          "id": "g-score",
          "name": "score",
          "type": "number",
          "initial": 0
        },
        {
          "id": "g-lives",
          "name": "lives",
          "type": "number",
          "initial": 3
        }
      ]
    },
    "input.map": {
      "version": 1,
      "deadzone": 0.2,
      "actions": [
        {
          "id": "a-move",
          "name": "Move",
          "kind": "axis",
          "bindings": [
            {
              "type": "keyAxis",
              "negative": "ArrowLeft",
              "positive": "ArrowRight"
            },
            {
              "type": "keyAxis",
              "negative": "KeyA",
              "positive": "KeyD"
            }
          ],
          "globalId": "g-move"
        }
      ]
    },
    "scripts.library": {
      "version": 1,
      "items": [
        {
          "id": "s-paddle",
          "name": "Paddle",
          "source": "export function update(self: GameObject, dt: number) {\n  self.x = Math.max(78, Math.min(882, self.x + globals.move * 560 * dt));\n}",
          "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true}); function update(self, dt) {\n  self.x = Math.max(78, Math.min(882, self.x + globals.move * 560 * dt));\n} exports.update = update;"
        },
        {
          "id": "s-ball",
          "name": "Ball",
          "source": "export const params = { speed: param.number(400) };\nexport function start(self: GameObject) { self.state.wait = 0.8; }\nexport function update(self: GameObject, dt: number) {\n  if (self.state.wait > 0) { self.state.wait -= dt; if (self.state.wait <= 0) self.body.velocity = { x: 150, y: -self.params.speed }; return; }\n  const v = self.body.velocity, length = Math.hypot(v.x, v.y) || 1;\n  let vx = v.x / length * self.params.speed, vy = v.y / length * self.params.speed;\n  if (Math.abs(vy) < 140) vy = vy < 0 ? -140 : 140;\n  self.body.velocity = { x: vx, y: vy };\n  if (self.y > 580) {\n    globals.lives -= 1;\n    if (globals.lives <= 0) { game.changeScene('Game over'); return; }\n    self.body.teleport(480, 470); self.body.velocity = { x: 0, y: 0 }; self.state.wait = 0.8; game.camera.shake(10, 0.3);\n  }\n}\nexport function onCollision(self: GameObject, other: GameObject) {\n  if (other.name === 'Paddle') self.body.velocity = { x: (self.x - other.x) / 60 * self.params.speed, y: -self.params.speed };\n}",
          "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true}); const params = { speed: param.number(400) }; exports.params = params;\n function start(self) { self.state.wait = 0.8; } exports.start = start;\n function update(self, dt) {\n  if (self.state.wait > 0) { self.state.wait -= dt; if (self.state.wait <= 0) self.body.velocity = { x: 150, y: -self.params.speed }; return; }\n  const v = self.body.velocity, length = Math.hypot(v.x, v.y) || 1;\n  let vx = v.x / length * self.params.speed, vy = v.y / length * self.params.speed;\n  if (Math.abs(vy) < 140) vy = vy < 0 ? -140 : 140;\n  self.body.velocity = { x: vx, y: vy };\n  if (self.y > 580) {\n    globals.lives -= 1;\n    if (globals.lives <= 0) { game.changeScene('Game over'); return; }\n    self.body.teleport(480, 470); self.body.velocity = { x: 0, y: 0 }; self.state.wait = 0.8; game.camera.shake(10, 0.3);\n  }\n} exports.update = update;\n function onCollision(self, other) {\n  if (other.name === 'Paddle') self.body.velocity = { x: (self.x - other.x) / 60 * self.params.speed, y: -self.params.speed };\n} exports.onCollision = onCollision;"
        },
        {
          "id": "s-brick",
          "name": "Brick",
          "source": "export function onCollision(self: GameObject, other: GameObject) {\n  if (other.name !== 'Ball' || !self.active) return;\n  self.active = false;\n  globals.score += 10;\n  if (game.findAll('Brick').every(b => !b.active)) game.changeScene('You win');\n}",
          "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true}); function onCollision(self, other) {\n  if (other.name !== 'Ball' || !self.active) return;\n  self.active = false;\n  globals.score += 10;\n  if (game.findAll('Brick').every(b => !b.active)) game.changeScene('You win');\n} exports.onCollision = onCollision;"
        }
      ]
    }
  }
}
