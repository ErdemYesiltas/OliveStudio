     "kind": "extra",
     "wgsl": {
      "header": "",
      "material": "  // Bands along world height, moving with game time.\n  let band = step(0.5, fract(input.vPosition.y * material.density - material.time * material.speed));\n  albedo = mix(albedo, material.stripe.rgb, band * 0.85);",
