    "studio": "1.0.0"
  },
  "providers": {
    "audio": "howler",
    "tween": "gsap",
    "physics": "matter",
    "render": "pixi"
  },
  "extensions": {
    "pixi.render": {
      "version": 1,
      "background": "#8fd3ff"
    },
    "physics.world": {
      "gravityX": 0,
      "gravityY": 1400,
      "timeScale": 1,
      "sleeping": false,
      "positionIterations": 8,
      "velocityIterations": 6,
      "walls": false,
      "layers": [
        "Default"
      ]
    },
    "interactions.globals": {
      "version": 1,
      "items": [
        {
          "id": "g-move",
          "name": "move",
          "type": "number",
          "initial": 0
        },
        {
          "id": "g-coins",
          "name": "coins",
          "type": "number",
          "initial": 0
        }
      ]
    },
    "input.map": {
      "version": 1,
      "deadzone": 0.2,
      "actions": [
        {
          "id": "a-move",
          "name": "Move",
          "kind": "axis",
          "bindings": [
            {
              "type": "keyAxis",
              "negative": "ArrowLeft",
              "positive": "ArrowRight"
            },
            {
              "type": "keyAxis",
              "negative": "KeyA",
              "positive": "KeyD"
            }
          ],
          "globalId": "g-move"
        },
        {
          "id": "a-jump",
          "name": "Jump",
          "kind": "button",
          "bindings": [
            {
              "type": "key",
              "code": "Space"
            },
            {
              "type": "key",
              "code": "ArrowUp"
            },
            {
              "type": "key",
              "code": "KeyW"
            }
          ]
        }
      ]
    },
    "scripts.library": {
      "version": 1,
      "items": [
        {
          "id": "s-hero",
          "name": "Hero",
          "source": "export const params = { speed: param.number(280), jump: param.number(640) };\nexport function start(self: GameObject) { self.state.spawn = { x: self.x, y: self.y }; }\nexport function update(self: GameObject) {\n  const feet = (dx: number) => game.physics.raycast(self.x + dx, self.y + 24, self.x + dx, self.y + 32) !== null;\n  const grounded = feet(-14) || feet(14);\n  const jump = game.isDown('Jump');\n  let vy = self.body.velocity.y;\n  if (grounded && jump && !self.state.held) vy = -self.params.jump;\n  self.state.held = jump;\n  self.body.velocity = { x: globals.move * self.params.speed, y: vy };\n  if (self.y > 720) { self.body.teleport(self.state.spawn.x, self.state.spawn.y); self.body.velocity = { x: 0, y: 0 }; game.camera.shake(12, 0.3); }\n}\nexport function onCollision(self: GameObject, other: GameObject) {\n  if (other.name === 'Coin' && other.active) { other.active = false; globals.coins += 1; }\n  if (other.name === 'Goal') game.changeScene('You win');\n}",
          "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true}); const params = { speed: param.number(280), jump: param.number(640) }; exports.params = params;\n function start(self) { self.state.spawn = { x: self.x, y: self.y }; } exports.start = start;\n function update(self) {\n  const feet = (dx) => game.physics.raycast(self.x + dx, self.y + 24, self.x + dx, self.y + 32) !== null;\n  const grounded = feet(-14) || feet(14);\n  const jump = game.isDown('Jump');\n  let vy = self.body.velocity.y;\n  if (grounded && jump && !self.state.held) vy = -self.params.jump;\n  self.state.held = jump;\n  self.body.velocity = { x: globals.move * self.params.speed, y: vy };\n  if (self.y > 720) { self.body.teleport(self.state.spawn.x, self.state.spawn.y); self.body.velocity = { x: 0, y: 0 }; game.camera.shake(12, 0.3); }\n} exports.update = update;\n function onCollision(self, other) {\n  if (other.name === 'Coin' && other.active) { other.active = false; globals.coins += 1; }\n  if (other.name === 'Goal') game.changeScene('You win');\n} exports.onCollision = onCollision;"
        }
      ]
    }
  }
}
