          "initial": 0
        }
      ]
    },
    "input.map": {
      "version": 1,
      "deadzone": 0.2,
      "actions": [
        {
          "id": "a-up",
          "name": "Up",
          "kind": "button",
          "bindings": [
            {
              "type": "key",
              "code": "ArrowUp"
