   "items": [
    {
     "id": "e5484749-b94a-4e95-8c27-d7f31bb4ae8c",
     "name": "Lifetime",
     "source": "// Takes the castle out of the scene two ways and brings it back; the text shows what is still loaded.\nexport const params = {castle: param.object<GameObject3D>({label: 'Castle'})};\nexport function start(self: GameObject) { self.state.note = 'In the scene'; }\nexport function onMessage(self: GameObject, message: string) {\n  const castle = self.params.castle as GameObject3D;\n  if (message === 'hide') { castle.active = false; self.state.note = 'Hidden: not drawn, its model stays loaded'; }\n  if (message === 'unload') { castle.model.unload(); self.state.note = 'Unloaded: the object stays, its model is freed'; }\n  if (message === 'back') {\n    castle.active = true; self.state.note = 'Loading…';\n    castle.model.load().then(() => { self.state.note = 'Back in the scene'; });\n  }\n}\nexport function update(self: GameObject) {\n  const castle = self.params.castle as GameObject3D, files = game.assets.stats();\n  self.text = self.state.note + '\\nactive: ' + castle.active + ' · model: ' + castle.model.state + ' · model files loaded: ' + (files ? files.loaded : 0);\n}\n",
     "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true});// Takes the castle out of the scene two ways and brings it back; the text shows what is still loaded.\n const params = {castle: param.object({label: 'Castle'})}; exports.params = params;\n function start(self) { self.state.note = 'In the scene'; } exports.start = start;\n function onMessage(self, message) {\n  const castle = self.params.castle ;\n  if (message === 'hide') { castle.active = false; self.state.note = 'Hidden: not drawn, its model stays loaded'; }\n  if (message === 'unload') { castle.model.unload(); self.state.note = 'Unloaded: the object stays, its model is freed'; }\n  if (message === 'back') {\n    castle.active = true; self.state.note = 'Loading…';\n    castle.model.load().then(() => { self.state.note = 'Back in the scene'; });\n  }\n} exports.onMessage = onMessage;\n function update(self) {\n  const castle = self.params.castle , files = game.assets.stats();\n  self.text = self.state.note + '\\nactive: ' + castle.active + ' · model: ' + castle.model.state + ' · model files loaded: ' + (files ? files.loaded : 0);\n} exports.update = update;\n"
    },
    {
     "id": "ae7c9c5e-71ff-4564-8200-ca92a368e553",
     "name": "Button",
     "source": "// Sends its message to every script (the Lifetime script on the status line reacts).\nexport const params = {message: param.choice(['hide', 'unload', 'back'])};\nexport function onClick(self: GameObject) { game.send(self.params.message); }\n",
     "code": "\"use strict\";Object.defineProperty(exports, \"__esModule\", {value: true});// Sends its message to every script (the Lifetime script on the status line reacts).\n const params = {message: param.choice(['hide', 'unload', 'back'])}; exports.params = params;\n function onClick(self) { game.send(self.params.message); } exports.onClick = onClick;\n"
    }
   ]
