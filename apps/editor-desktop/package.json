{
  "name": "@rewrite/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac": "node ../../scripts/mac-app.mjs --mode local",
    "package:mac:adhoc": "node ../../scripts/mac-app.mjs --mode local",
    "package:mac:release": "node ../../scripts/mac-app.mjs --mode release"
  },
  "dependencies": {
    "@assetpack/core": "1.7.0",
    "@dnd-kit/core": "6.3.1",
    "@esotericsoftware/spine-core": "4.2.120",
    "@rewrite/achievements": "workspace:*",
    "@rewrite/ai-comfy": "workspace:*",
    "@rewrite/ai-hub": "workspace:*",
    "@rewrite/ai-lm": "workspace:*",
    "@rewrite/ai-skills": "workspace:*",
    "@rewrite/animation": "workspace:*",
    "@rewrite/assetpack": "workspace:*",
    "@rewrite/assets": "workspace:*",
    "@rewrite/audio": "workspace:*",
    "@rewrite/audio-howler": "workspace:*",
    "@rewrite/behavior": "workspace:*",
    "@rewrite/behavior-xstate": "workspace:*",
    "@rewrite/build": "workspace:*",
    "@rewrite/dialogue": "workspace:*",
    "@rewrite/documents": "workspace:*",
    "@rewrite/html-export": "workspace:*",
    "@rewrite/input": "workspace:*",
    "@rewrite/interactions": "workspace:*",
    "@rewrite/kernel": "workspace:*",
    "@rewrite/layout": "workspace:*",
    "@rewrite/lighting": "workspace:*",
    "@rewrite/multiplayer": "workspace:*",
    "@rewrite/multiplayer-colyseus": "workspace:*",
    "@rewrite/navigation": "workspace:*",
    "@rewrite/particles": "workspace:*",
    "@rewrite/physics": "workspace:*",
    "@rewrite/physics-matter": "workspace:*",
    "@rewrite/prefabs": "workspace:*",
    "@rewrite/production-tools": "workspace:*",
    "@rewrite/profiler": "workspace:*",
    "@rewrite/project": "workspace:*",
    "@rewrite/recovery": "workspace:*",
    "@rewrite/render-pixi": "workspace:*",
    "@rewrite/runtime": "workspace:*",
    "@rewrite/scene": "workspace:*",
    "@rewrite/scripts": "workspace:*",
    "@rewrite/sdk": "workspace:*",
    "@rewrite/spine": "workspace:*",
    "@rewrite/spine-audio": "workspace:*",
    "@rewrite/tween": "workspace:*",
    "@rewrite/tween-gsap": "workspace:*",
    "@rewrite/tween-pixi": "workspace:*",
    "@rewrite/ui": "workspace:*",
    "dockview": "4.13.1",
    "lucide-react": "1.72.0",
    "music-metadata": "12.5.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.1.4",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "gsap": "3.15.1",
    "howler": "2.2.4",
    "motion": "14.13.0",
    "vite": "7.3.1"
  },
  "build": {
    "appId": "dev.olivestudio.app",
    "productName": "OliveStudio",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSHighResolutionCapable": true
      },
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "asarUnpack": [
      "**/*.node",
      "**/sharp/**/*",
      "**/@img/**/*",
      "**/@gpu-tex-enc/basis/bin/**/*"
    ],
    "extraResources": [
      {
        "from": "../../third-party/SPINE-RUNTIMES-LICENSE.txt",
        "to": "licenses/SPINE-RUNTIMES-LICENSE.txt"
      },
      {
        "from": "../../examples",
        "to": "examples",
        "filter": [
          "**/*",
          "!**/expected-export.json",
          "!pixi3d-*/**"
        ]
      }
    ],
    "copyright": "Copyright \u00a9 2026 OliveStudio",
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "author": "OliveStudio",
  "description": "Modular canvas-first 2D editor foundation",
  "license": "MIT"
}
